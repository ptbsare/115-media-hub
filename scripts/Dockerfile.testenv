# 测试专用环境镜像：在应用镜像之上补齐 node（前端 JS 测试）与 httpx（TestClient 依赖）。
#
# 为什么需要它：本机安全策略会拦「删除文件」，而 unittest / SQLite / 跨盘复制的临时文件
# 清理都要真删文件。本机不加提权跑全量会刷出一堆与代码无关的失败，加提权又每次都要人工批准。
# 容器里没有这条限制，所以「跑全量」这件事放到容器里做，一次构建、之后零批准。
#
# 构建：scripts/test_in_container.sh --rebuild
FROM 115-media-hub-115-media-hub-test:latest

RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends nodejs \
 && rm -rf /var/lib/apt/lists/* \
 && pip install --no-cache-dir -q httpx
