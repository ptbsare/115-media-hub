# 复制这个文件为 .env，然后按你的实际情况改。
#
#   cp .env.example .env
#
# docker compose 会自动读取同目录下的 .env，把它里面的值替换 compose.yml 里的 ${...}。
# .env 已被 .gitignore 忽略，不会被提交。

# 容器名。同时跑多个实例时改成不同名字。
MH_CONTAINER_NAME=115-media-hub

# 网页端口（左边宿主机端口，右边容器内固定 18080）
MH_PORT=18080

# 数据目录。不填就用项目下的 ./data/。
# 想放到大盘 / NAS 就填绝对路径，比如 /mnt/hdd/115-media-hub/config。
# 注意 config 里装着数据库、Cookie 和全部设置，删掉等于重置。
MH_CONFIG_DIR=./data/config
MH_STRM_DIR=./data/strm
MH_LOGS_DIR=./data/logs

# 跨盘复制的本地暂存区（可选）。不映射也能用，暂存会落在 config 卷里。
MH_STORAGE_DIR=./data/storage

# 时区
TZ=Asia/Shanghai
